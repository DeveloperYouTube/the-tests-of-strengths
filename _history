this.ry = 0\n        this.rz = 0\n        this.vrx = 0\n        this.vry = 0\n        this.vrz = 0\n\n        // Initialize Angular Friction\n        this.frx = 0\n        this.fry = 0\n        this.frz = 0\n    }\n\n    /**\n     * Integrates 3D linear and angular physics over time step dt.\n     * Automatically applies 2D screen-plane rotation via spriteFx using rz.\n     */\n    public updateKinematics(dt: number): void {\n        // Z-axis movement\n        this.vz += (this.az + this.fz) * dt\n        this.z += this.vz * dt\n\n        // Angular movement (Degrees)\n        this.rx += this.vrx * dt\n        this.ry += this.vry * dt\n        this.rz += this.vrz * dt\n\n        // Angular damping\n        if (this.frx > 0) this.vrx *= Math.max(0, 1 - this.frx * dt)\n        if (this.fry > 0) this.vry *= Math.max(0, 1 - this.fry * dt)\n        if (this.frz > 0) this.vrz *= Math.max(0, 1 - this.frz * dt)\n\n        // Apply 2D roll rotation directly using spriteFx\n        spriteFx.setRotation(this, this.rz)\n    }\n\n    /**\n     * Applies an instant velocity boost along the Z axis.\n     */\n    public applyImpulseZ(impulse: number): void {\n        this.vz += impulse\n    }\n\n    /**\n     * Calculates scale multipliers where 90 deg rotation displays 'depth' pixels.\n     * Scale factors are relative to 1.0 (original image dimensions).\n     */\n    public getRenderScale(): { scaleX: number; scaleY: number } {\n        const radX = (this.rx * Math.PI) / 180\n        const radY = (this.ry * Math.PI) / 180\n\n        const baseWidth = this.image.width\n        const baseHeight = this.image.height\n\n        // Projected pixel dimensions including depth thickness\n        const projectedWidthPx = baseWidth * Math.abs(Math.cos(radY)) + this.depth * Math.abs(Math.sin(radY))\n        const projectedHeightPx = baseHeight * Math.abs(Math.cos(radX)) + this.depth * Math.abs(Math.sin(radX))\n\n        return {\n            scaleX: projectedWidthPx / baseWidth,\n            scaleY: projectedHeightPx / baseHeight\n        }\n    }\n\n    /**\n     * Helper returning exact target dimensions in raw screen pixels.\n     */\n    public getRenderDimensions(): { widthPx: number; heightPx: number } {\n        const scale = this.getRenderScale()\n        return {\n            widthPx: this.image.width * scale.scaleX,\n            heightPx: this.image.height * scale.scaleY\n        }\n    }\n\n    /**\n     * Checks if this sprite can move to a given target position against tile height.\n     */\n    public canMoveToTile(targetX: number, targetY: number, getTileHeight: (tx: number, ty: number) => number): boolean {\n        const tileX = Math.floor(targetX / 16)\n        const tileY = Math.floor(targetY / 16)\n        const tileHeight = getTileHeight(tileX, tileY)\n\n        // Block movement if tile height is greater than sprite's current Z position\n        return tileHeight <= this.z\n    }\n\n    /**\n     * Resets all 3D fields to zero.\n     */\n    public reset3D(): void {\n        this.depth = 0\n        this.vz = 0\n        this.az = 0\n        this.fz = 0\n        this.rx = 0\n        this.ry = 0\n        this.rz = 0\n        this.vrx = 0\n        this.vry = 0\n        this.vrz = 0\n        this.frx = 0\n        this.fry = 0\n        this.frz = 0\n\n        spriteFx.setRotation(this, 0)\n    }\n}\n\n// Full Property Enum including standard Sprite fields and Sprite3 fields\nenum Sprite3Property {\n    // Standard 2D Position & Size\n    //% block=\"x (horizontal position)\"\n    X,\n    //% block=\"y (vertical position)\"\n    Y,\n    //% block=\"z (draw depth)\"\n    Z,\n    //% block=\"left\"\n    Left,\n    //% block=\"right\"\n    Right,\n    //% block=\"top\"\n    Top,\n    //% block=\"bottom\"\n    Bottom,\n    //% block=\"width\"\n    Width,\n    //% block=\"height\"\n    Height,\n\n    // Standard 2D Physics\n    //% block=\"vx (velocity x)\"\n    Vx,\n    //% block=\"vy (velocity y)\"\n    Vy,\n    //% block=\"ax (acceleration x)\"\n    Ax,\n    //% block=\"ay (acceleration y)\"\n    Ay,\n    //% block=\"fx (friction x)\"\n    Fx,\n    //% block=\"fy (friction y)\"\n    Fy,\n\n    // 3D Kinematics & Depth\n    //% block=\"depth\"\n    Depth,\n    //% block=\"vz (velocity z)\"\n    Vz,\n    //% block=\"az (acceleration z)\"\n    Az,\n    //% block=\"fz (friction z)\"\n    Fz,\n\n    // 3D Rotations (Degrees)\n    //% block=\"rx (pitch)\"\n    Rx,\n    //% block=\"ry (yaw)\"\n    Ry,\n    //% block=\"rz (roll)\"\n    Rz,\n\n    // 3D Angular Velocities\n    //% block=\"vrx (angular velocity x)\"\n    Vrx,\n    //% block=\"vry (angular velocity y)\"\n    Vry,\n    //% block=\"vrz (angular velocity z)\"\n    Vrz,\n\n    // 3D Angular Friction\n    //% block=\"frx (angular friction x)\"\n    Frx,\n    //% block=\"fry (angular friction y)\"\n    Fry,\n    //% block=\"frz (angular friction z)\"\n    Frz,\n\n    // Standard Sprite Miscellaneous\n    //% block=\"scale\"\n    Scale,\n    //% block=\"lifespan\"\n    Lifespan\n}\n\nenum Sprite3ScaleAxis {\n    //% block=\"scale X\"\n    ScaleX,\n    //% block=\"scale Y\"\n    ScaleY\n}\n\nenum Sprite3DimensionAxis {\n    //% block=\"width (px)\"\n    WidthPx,\n    //% block=\"height (px)\"\n    HeightPx\n}\n\n// Namespace with complete getter, setter, and changer implementations\n//% color=\"#5C2D91\" icon=\"\\uf1b9\" block=\"Sprite3D\"\nnamespace sprite3d {\n\n    /**\n     * Creates a new 3D sprite and adds it to the active scene.\n     */\n    //% block=\"create 3D sprite %img=screen_image_picker of kind %kind=spritekind\"\n    //% blockSetVariable=mySprite3\n    //% weight=100\n    export function createSprite3(img: Image, kind?: number): Sprite3 {\n        const sprite = new Sprite3(img, kind)\n        game.currentScene().physicsEngine.addSprite(sprite)\n        return sprite\n    }\n\n    /**\n     * Updates 3D kinematics for a 3D sprite. Call in game loop with dt.\n     */\n    //% block=\"update %sprite=variables_get(mySprite3) kinematics with dt %dt\"\n    //% weight=90\n    export function updateKinematics(sprite: Sprite3, dt: number): void {\n        if (sprite) {\n            sprite.updateKinematics(dt)\n        }\n    }\n\n    /**\n     * Sets a 2D or 3D numeric property on a 3D sprite.\n     */\n    //% block=\"set %sprite=variables_get(mySprite3) %prop to %value\"\n    //% weight=80\n    export function setProperty(sprite: Sprite3, prop: Sprite3Property, value: number): void {\n        if (!sprite) return\n        switch (prop) {\n            // Standard 2D Position\n            case Sprite3Property.X: sprite.x = value; break\n            case Sprite3Property.Y: sprite.y = value; break\n            case Sprite3Property.Z: sprite.z = value; break\n            case Sprite3Property.Left: sprite.left = value; break\n            case Sprite3Property.Right: sprite.right = value; break\n            case Sprite3Property.Top: sprite.top = value; break\n            case Sprite3Property.Bottom: sprite.bottom = value; break\n\n            // Standard 2D Physics\n            case Sprite3Property.Vx: sprite.vx = value; break\n            case Sprite3Property.Vy: sprite.vy = value; break\n            case Sprite3Property.Ax: sprite.ax = value; break\n            case Sprite3Property.Ay: sprite.ay = value; break\n            case Sprite3Property.Fx: sprite.fx = value; break\n            case Sprite3Property.Fy: sprite.fy = value; break\n\n            // 3D Kinematics\n            case Sprite3Property.Depth: sprite.depth = value; break\n            case Sprite3Property.Vz: sprite.vz = value; break\n            case Sprite3Property.Az: sprite.az = value; break\n            case Sprite3Property.Fz: sprite.fz = value; break\n\n            // 3D Rotations\n            case Sprite3Property.Rx: sprite.rx = value; break\n            case Sprite3Property.Ry: sprite.ry = value; break\n            case Sprite3Property.Rz:\n                sprite.rz = value\n                spriteFx.setRotation(sprite, sprite.rz)\n                break\n\n            // 3D Angular Velocities\n            case Sprite3Property.Vrx: sprite.vrx = value; break\n            case Sprite3Property.Vry: sprite.vry = value; break\n            case Sprite3Property.Vrz: sprite.vrz = value; break\n\n            // 3D Angular Friction\n            case Sprite3Property.Frx: sprite.frx = value; break\n            case Sprite3Property.Fry: sprite.fry = value; break\n            case Sprite3Property.Frz: sprite.frz = value; break\n\n            // Standard Sprite Misc\n            case Sprite3Property.Scale: sprite.setScale(value); break\n            case Sprite3Property.Lifespan: sprite.lifespan = value; break\n        }\n    }\n\n    /**\n     * Gets a 2D or 3D numeric property from a 3D sprite.\n     */\n    //% block=\"%sprite=variables_get(mySprite3) %prop\"\n    //% weight=75\n    export function getProperty(sprite: Sprite3, prop: Sprite3Property): number {\n        if (!sprite) return 0\n        switch (prop) {\n            // Standard 2D Position & Size\n            case Sprite3Property.X: return sprite.x\n            case Sprite3Property.Y: return sprite.y\n            case Sprite3Property.Z: return sprite.z\n            case Sprite3Property.Left: return sprite.left\n            case Sprite3Property.Right: return sprite.right\n            case Sprite3Property.Top: return sprite.top\n            case Sprite3Property.Bottom: return sprite.bottom\n            case Sprite3Property.Width: return sprite.width\n            case Sprite3Property.Height: return sprite.height\n\n            // Standard 2D Physics\n            case Sprite3Property.Vx: return sprite.vx\n            case Sprite3Property.Vy: return sprite.vy\n            case Sprite3Property.Ax: return sprite.ax\n            case Sprite3Property.Ay: return sprite.ay\n            case Sprite3Property.Fx: return sprite.fx\n            case Sprite3Property.Fy: return sprite.fy\n\n            // 3D Kinematics\n            case Sprite3Property.Depth: return sprite.depth\n            case Sprite3Property.Vz: return sprite.vz\n            case Sprite3Property.Az: return sprite.az\n            case Sprite3Property.Fz: return sprite.fz\n\n            // 3D Rotations\n            case Sprite3Property.Rx: return sprite.rx\n            case Sprite3Property.Ry: return sprite.ry\n            case Sprite3Property.Rz: return sprite.rz\n\n            // 3D Angular Velocities\n            case Sprite3Property.Vrx: return sprite.vrx\n            case Sprite3Property.Vry: return sprite.vry\n            case Sprite3Property.Vrz: return sprite.vrz\n\n            // 3D Angular Friction\n            case Sprite3Property.Frx: return sprite.frx\n            case Sprite3Property.Fry: return sprite.fry\n            case Sprite3Property.Frz: return sprite.frz\n\n            // Standard Sprite Misc\n            case Sprite3Property.Lifespan: return sprite.lifespan\n            default: return 0\n        }\n    }\n\n    /**\n     * Changes a 2D or 3D property on a 3D sprite by an amount.\n     */\n    //% block=\"change %sprite=variables_get(mySprite3) %prop by %delta\"\n    //% weight=70\n    export function changeProperty(sprite: Sprite3, prop: Sprite3Property, delta: number): void {\n        if (!sprite) return\n        const current = getProperty(sprite, prop)\n        setProperty(sprite, prop, current + delta)\n    }\n\n    /**\n     * Gets projected scale multiplier for X or Y axis based on rx, ry, and depth.\n     */\n    //% block=\"%sprite=variables_get(mySprite3) render %axis\"\n    //% weight=50\n    export function getRenderScale(sprite: Sprite3, axis: Sprite3ScaleAxis): number {\n        if (!sprite) return 1\n        const scale = sprite.getRenderScale()\n        return axis === Sprite3ScaleAxis.ScaleX ? scale.scaleX : scale.scaleY\n    }\n\n    /**\n     * Gets projected pixel width or height based on rx, ry, and depth.\n     */\n    //% block=\"%sprite=variables_get(mySprite3) target pixel %axis\"\n    //% weight=40\n    export funct