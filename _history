<= r; index++) {\n            slice.setPixel(Math.round(cosVal * index + r), Math.round(sinVal * index + r), c)\n        }\n    }\nspriteutils.drawTransparentImage(slice, image2, cx - r, cy - r)\n}\nlet stamina_down = false\nlet stamina_drain = 0\nlet bottom2 = 0\nlet top2 = 0\nlet right2 = 0\nlet left2 = 0\nlet bottom = 0\nlet top = 0\nlet right = 0\nlet left = 0\nlet dt = 0\nlet slice: Image = null\nlet slice2 = null\nlet myImage = null\nlet newX = 0\nlet newY: number = 0\nlet arc = null\nlet rings: number[] = []\nlet ring = 0\nlet val = 0\nlet drain = 0\nlet solid = 0\nlet stamine_nouse = 1\nlet last_time = game.runtime()\nlet stamina = 1080\ntiles.setCurrentTilemap(tilemap`map`)\nlet link = sprites.create(assets.image`link`, SpriteKind.Player)\ncontroller.moveSprite(link, 80, 80)\ntiles.placeOnRandomTile(link, assets.tile`spawn`)\ntiles.setTileAt(link.tilemapLocation(), assets.tile`floor`)\nlet overlay = sprites.create(assets.image`camera`, SpriteKind.Overlay)\nlet camera_center = sprites.create(assets.image`empty 2x2`, SpriteKind.Overlay)\nscene.cameraFollowSprite(camera_center)\ngame.onUpdate(function () {\n    dt = (game.runtime() - last_time) / 1000\n    last_time = game.runtime()\n    newX = link.x\n    newY = link.y\n    let dirX = Math.sign(newX - overlay.x)\nlet dirY = Math.sign(newY - overlay.y)\n// 1. Resolve X Axis\n    if (dirX != 0) {\n        left = newX - 80\n        right = newX + 80\n        top = overlay.y - 60\n        bottom = overlay.y + 60\n        for (let location of tiles.getTilesByType(assets.tile`camerawall`)) {\n            if (right > location.x - 8 && left < location.x + 8 && bottom > location.y - 8 && top < location.y + 8) {\n                if (dirX > 0 && newX < location.x) {\n                    newX = location.column * 16 - 80\n                }\n                if (dirX < 0 && newX > location.x) {\n                    newX = location.column * 16 + 96\n                }\n            }\n        }\n    }\n    // 2. Resolve Y Axis (using updated newX)\n    if (dirY != 0) {\n        left2 = newX - 80\n        right2 = newX + 80\n        top2 = newY - 60\n        bottom2 = newY + 60\n        for (let location2 of tiles.getTilesByType(assets.tile`camerawall`)) {\n            if (right2 > location2.x - 8 && left2 < location2.x + 8 && bottom2 > location2.y - 8 && top2 < location2.y + 8) {\n                if (dirY > 0 && newY < location2.y) {\n                    newY = location2.row * 16 - 60\n                }\n                if (dirY < 0 && newY > location2.y) {\n                    newY = location2.row * 16 + 76\n                }\n            }\n        }\n    }\n    overlay.setPosition(newX, newY)\n    camera_center.setPosition(overlay.x, overlay.y)\n    stamina_drain = 0\n    if (controller.dx() != 0 || controller.dy() != 0) {\n        spriteFx.setRotation(link, spriteutils.radiansToDegrees(Math.atan2(controller.dy(), controller.dx())))\n        if (!(stamina_down)) {\n            if (browserEvents.Shift.isPressed()) {\n                controller.moveSprite(link, 128, 128)\n                stamina_drain += -72\n                stamine_nouse = 0\n            } else {\n                controller.moveSprite(link, 80, 80)\n            }\n        }\n    }\n    if (stamina_drain <= 0) {\n        stamine_nouse += dt\n        if (stamine_nouse >= 1) {\n            stamina_drain += 216\n        }\n    }\n    stamina = Math.min(stamina + stamina_drain * dt, 1080)\n    if (stamina <= 0) {\n        stamina_down = true\n        stamina = 0\n        controller.moveSprite(link, 56, 56)\n    }\n    if (stamina >= 1080 && stamina_down == true) {\n        stamina_down = false\n        controller.moveSprite(link, 80, 80)\n    }\n\n    overlay.image.fill(0)\n    if (stamina != 1080) {\n\n        const sx = link.x - overlay.x + 70\n        const sy = link.y - overlay.y + 50\n\n        let outer_radii = [3, 6, 8]\n        let inner_radii = [2, 6, 8]\n        let base_stamina = [0, 360, 720]\n\n        for (let r = 0; r < 3; r++) {\n            let mar = outer_radii[r]\n            let mir = inner_radii[r]\n            let base = base_stamina[r]\n\n            let val = Math.max(0, Math.min(360, stamina - base))\n\n            if (stamina_down) {\n                // Exhausted State: Orange refill (4), Black track (15)\n                draw_arc(overlay.image, sx, sy, mar, mir, 89, val+91, 4)\n                draw_arc(overlay.image, sx, sy, mar, mir, val+89, 451, 15)\n            } else {\n                // Only apply your drain logic if stamina is currently inside this wheel's 0-360 range\n                let is_active_wheel = (stamina > base && stamina <= base + 360)\n\n                let drain = is_active_wheel ? Math.min(val, -stamina_drain) : 0\n                let solid = val - drain\n\n                draw_arc(overlay.image, sx, sy, mar, mir, 89, solid+91, 7)\n                draw_arc(overlay.image, sx, sy, mar, mir, solid+89, val+91, 2)\n                draw_arc(overlay.image, sx, sy, mar, mir, val+89, 451, 15)\n            }\n        }\n    }\n})\n","README.md":" ","assets.json":"","tilemap.g.jres":"{\n    \"transparency16\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true\n    },\n    \"tile1\": {\n        \"data\": \"hwQQABAAAAD//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////w==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true,\n        \"displayName\": \"wall\"\n    },\n    \"tile2\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAPD/AAAAAADw//8AAAAAAP///wAAAADw////AAAAAPD///8AAAAA/////wAAAAD//5n/AAAAAP//mf8AAAAA/////wAAAADw////AAAAAPD///8AAAAAAP///wAAAAAA8P//AAAAAAAA8P8AAAAAAA